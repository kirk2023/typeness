{
  "name": "typeness",
  "version": "0.1.0",
  "description": "Voice input method that cleans up spoken text",
  "author": "Typeness",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:dir": "vite build && electron-builder --dir",
    "build:portable": "set ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ && vite build && electron-builder --win --x64",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "electron-store": "^11.0.0",
    "robotjs": "^0.7.1",
    "sherpa-onnx-node": "^1.13.2",
    "vosk-browser": "^0.0.8"
  }
}
